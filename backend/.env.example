# ==================================================
# JYSA Media — Backend Environment Variables
# ==================================================
# Copy this file to .env and fill in your credentials.
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ==================================================

SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CONTACT_RECEIVER=

# Server port (default: 3001)
PORT=3001

# Frontend origin for CORS (production domain, e.g. https://jysamedia.in)
# FRONTEND_ORIGIN=
